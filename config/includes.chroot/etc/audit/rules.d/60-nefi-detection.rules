## NEFI OS - telemetria del kernel per il motore di rilevamento (nefi-detectd)
## Caricato dopo 50-nefi.rules (che contiene gia' "-i": i percorsi mancanti vengono ignorati).

## Ogni programma eseguito: chi, da quale processo, con quali argomenti (albero dei processi)
-a always,exit -F arch=b64 -S execve,execveat -k nefi_exec
-a always,exit -F arch=b32 -S execve,execveat -k nefi_exec

## Lettura dei file con le password cifrate
-w /etc/shadow -p r -k nefi_cred
-w /etc/gshadow -p r -k nefi_cred

## Punti di persistenza non coperti dalle regole di base
-w /etc/cron.hourly/ -p wa -k nefi_persist
-w /etc/cron.daily/ -p wa -k nefi_persist
-w /etc/cron.weekly/ -p wa -k nefi_persist
-w /etc/cron.monthly/ -p wa -k nefi_persist
-w /var/spool/cron/ -p wa -k nefi_persist
-w /etc/systemd/user/ -p wa -k nefi_persist
-w /etc/xdg/autostart/ -p wa -k nefi_persist
-w /etc/profile -p wa -k nefi_persist
-w /etc/profile.d/ -p wa -k nefi_persist
-w /etc/bash.bashrc -p wa -k nefi_persist
-w /etc/rc.local -p wa -k nefi_persist
-w /etc/udev/rules.d/ -p wa -k nefi_persist
-w /etc/ld.so.preload -p wa -k nefi_preload
-w /etc/ld.so.conf.d/ -p wa -k nefi_preload
-w /etc/modules-load.d/ -p wa -k nefi_modconf
-w /etc/modprobe.d/ -p wa -k nefi_modconf

## Autenticazione
-w /etc/pam.d/ -p wa -k nefi_pam
-w /etc/security/ -p wa -k nefi_pam

## Difese: chi tocca la configurazione degli strumenti di sicurezza
-w /etc/audit/ -p wa -k nefi_defense
-w /etc/apparmor.d/ -p wa -k nefi_defense
-w /etc/nefi/ -p wa -k nefi_defense
-w /etc/fail2ban/ -p wa -k nefi_defense
-w /etc/falco/ -p wa -k nefi_defense
-w /etc/crowdsec/ -p wa -k nefi_defense
-w /etc/suricata/ -p wa -k nefi_defense
-w /usr/sbin/auditctl -p x -k nefi_defense_tool
-w /usr/sbin/nft -p x -k nefi_defense_tool
