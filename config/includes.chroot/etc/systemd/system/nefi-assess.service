[Unit]
Description=NEFI — System security assessment (Security Score and System pages)
After=network-online.target nftables.service apparmor.service auditd.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/nefi/system/collect.py
# priorita' minima: non rallenta il desktop
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/nefi
