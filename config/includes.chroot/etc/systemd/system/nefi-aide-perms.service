[Unit]
Description=NEFI — Fix AIDE database permissions
After=local-fs.target
ConditionPathIsDirectory=/var/lib/aide

[Service]
Type=oneshot
RemainAfterExit=yes
# stessi permessi di prima (il "-" vuol dire: se il file non c'e' non e' un errore)
ExecStart=-/bin/chmod 755 /var/lib/aide
ExecStart=-/bin/chmod 644 /var/lib/aide/aide.db

# ── Sandbox: il servizio puo' solo cambiare i permessi in /var/lib/aide ──
CapabilityBoundingSet=CAP_FOWNER
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/var/lib/aide
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
