[Unit]
Description=NEFI OS - Incident Response: keep the isolation state true across reboots
After=nftables.service local-fs.target
Before=network-pre.target
Wants=network-pre.target
ConditionPathExists=/var/lib/nefi/ir/ir-state.conf

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/nefi/ir/boot-check.sh

[Install]
WantedBy=multi-user.target
